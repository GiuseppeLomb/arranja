{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/GiuseppeLomb/arranja/schemas/common.schema.json",
	"title": "Definições comuns",
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
			"maxLength": 80,
			"description": "Identificador em minúsculas, com hífens (kebab-case)."
		},
		"data": {
			"type": "string",
			"format": "date",
			"description": "Data no formato AAAA-MM-DD."
		},
		"url": {
			"type": "string",
			"format": "uri",
			"pattern": "^https://",
			"description": "URL https."
		},
		"source": {
			"type": "object",
			"description": "Fonte verificável. Obrigatória para todo o conteúdo de reparação.",
			"required": [
				"url",
				"consultado_em"
			],
			"additionalProperties": false,
			"properties": {
				"url": {
					"$ref": "#/$defs/url"
				},
				"titulo": {
					"type": "string",
					"minLength": 3,
					"maxLength": 200
				},
				"consultado_em": {
					"$ref": "#/$defs/data"
				},
				"pagina": {
					"type": "string",
					"minLength": 1,
					"maxLength": 40,
					"description": "Página(s) do documento (ex.: 34 ou 34–36)."
				},
				"documento_oficial": {
					"type": "object",
					"description": "Cópia do manual OFICIAL do fabricante alojada por um retalhista. Obrigatório nesses domínios. Leva a referência impressa no documento ou, se não existir, a identificação (marcas de autenticidade).",
					"required": [
						"fabricante",
						"modelos",
						"url_alojamento",
						"alojado_por"
					],
					"additionalProperties": false,
					"properties": {
						"fabricante": {
							"$ref": "#/$defs/id",
							"description": "id da marca em data/brands.yaml"
						},
						"referencia_documento": {
							"type": "string",
							"minLength": 2,
							"maxLength": 60,
							"description": "Referência impressa no documento (ex.: MFL71766782)."
						},
						"modelos": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string",
								"minLength": 2,
								"maxLength": 40
							},
							"description": "Modelos exatos indicados no documento (ou, com modelos_fonte \"alojamento\", os que o retalhista associa ao documento)."
						},
						"url_alojamento": {
							"$ref": "#/$defs/url"
						},
						"alojado_por": {
							"type": "string",
							"minLength": 2,
							"maxLength": 80,
							"description": "Retalhista que aloja a cópia (ex.: Worten)."
						},
						"identificacao": {
							"type": "string",
							"minLength": 10,
							"maxLength": 200,
							"description": "Marcas de autenticidade quando o documento não tem referência impressa (fabricante, site oficial, modelos exatos)."
						},
						"modelos_fonte": {
							"enum": [
								"documento",
								"alojamento"
							],
							"description": "De onde vêm os modelos: \"documento\" (por omissão) ou \"alojamento\" — o documento tem referência impressa mas não indica o modelo, e os modelos são os que o retalhista associa a essa cópia."
						}
					},
					"anyOf": [
						{
							"required": [
								"referencia_documento"
							]
						},
						{
							"required": [
								"identificacao"
							]
						}
					],
					"if": {
						"properties": {
							"modelos_fonte": {
								"const": "alojamento"
							}
						},
						"required": [
							"modelos_fonte"
						]
					},
					"then": {
						"required": [
							"referencia_documento"
						]
					}
				}
			}
		},
		"sources": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/source"
			}
		},
		"padraoModelo": {
			"type": "string",
			"pattern": "^[A-Z0-9]+$",
			"description": "Identificador normalizado: maiúsculas, sem espaços, hífens, pontos ou barras."
		},
		"aplicavelA": {
			"type": "array",
			"minItems": 1,
			"description": "A que marcas/famílias/modelos se aplica. Sem familias/prefixos/regex/modelos = todos os modelos da marca.",
			"items": {
				"type": "object",
				"required": [
					"brand"
				],
				"additionalProperties": false,
				"properties": {
					"brand": {
						"oneOf": [
							{
								"$ref": "#/$defs/id"
							},
							{
								"const": "*"
							}
						],
						"description": "Id da marca, ou \"*\" para todas as marcas."
					},
					"familias": {
						"type": "array",
						"minItems": 1,
						"items": {
							"$ref": "#/$defs/id"
						}
					},
					"prefixos": {
						"type": "array",
						"minItems": 1,
						"items": {
							"$ref": "#/$defs/padraoModelo"
						}
					},
					"regex": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string",
							"minLength": 2,
							"maxLength": 200
						},
						"description": "Expressões regulares aplicadas ao identificador normalizado."
					},
					"modelos": {
						"type": "array",
						"minItems": 1,
						"items": {
							"$ref": "#/$defs/padraoModelo"
						}
					}
				}
			}
		},
		"licencaImagem": {
			"type": "string",
			"enum": [
				"CC0-1.0",
				"CC-BY-4.0",
				"CC-BY-SA-4.0",
				"CC-BY-NC-4.0",
				"CC-BY-NC-SA-4.0",
				"CC-BY-NC-SA-3.0"
			],
			"description": "Licença da imagem. Fotos próprias: CC-BY-NC-SA-4.0."
		},
		"imagem": {
			"type": "object",
			"required": [
				"src",
				"alt",
				"licenca",
				"autor"
			],
			"additionalProperties": false,
			"properties": {
				"src": {
					"type": "string",
					"pattern": "^imagens/[a-z0-9/_.-]+\\.(webp|png|jpg|jpeg|svg)$",
					"description": "Caminho relativo a /static (ex.: imagens/guias/x/passo-1.webp)."
				},
				"alt": {
					"type": "string",
					"minLength": 5,
					"maxLength": 300
				},
				"licenca": {
					"$ref": "#/$defs/licencaImagem"
				},
				"autor": {
					"type": "string",
					"minLength": 2,
					"maxLength": 120
				},
				"fonte_url": {
					"$ref": "#/$defs/url"
				}
			}
		},
		"example": {
			"type": "boolean",
			"description": "Conteúdo de exemplo: só aparece em desenvolvimento."
		}
	}
}
