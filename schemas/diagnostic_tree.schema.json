{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/GiuseppeLomb/arranja/schemas/diagnostic_tree.schema.json",
	"title": "Árvore de diagnóstico",
	"description": "Determinística: uma pergunta de cada vez; termina em guia(s), técnico ou dados insuficientes. Sem ciclos.",
	"type": "object",
	"required": [
		"id",
		"titulo",
		"sintoma",
		"appliance_type",
		"aplicavel_a",
		"inicio",
		"nos",
		"sources"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "common.schema.json#/$defs/id"
		},
		"titulo": {
			"type": "string",
			"minLength": 5,
			"maxLength": 120
		},
		"sintoma": {
			"type": "string",
			"minLength": 3,
			"maxLength": 80,
			"description": "Texto curto mostrado no passo Problema."
		},
		"appliance_type": {
			"$ref": "common.schema.json#/$defs/id"
		},
		"aplicavel_a": {
			"$ref": "common.schema.json#/$defs/aplicavelA"
		},
		"codigos": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/id"
			}
		},
		"inicio": {
			"$ref": "common.schema.json#/$defs/id"
		},
		"nos": {
			"type": "object",
			"minProperties": 2,
			"propertyNames": {
				"$ref": "common.schema.json#/$defs/id"
			},
			"additionalProperties": {
				"$ref": "#/$defs/no"
			}
		},
		"sources": {
			"$ref": "common.schema.json#/$defs/sources"
		},
		"example": {
			"$ref": "common.schema.json#/$defs/example"
		},
		"ordem": {
			"type": "integer",
			"minimum": 1,
			"maximum": 999,
			"description": "Posição na lista de sintomas (os mais comuns primeiro)."
		}
	},
	"$defs": {
		"no": {
			"type": "object",
			"required": [
				"tipo"
			],
			"properties": {
				"tipo": {
					"enum": [
						"pergunta",
						"guia",
						"tecnico",
						"dados_insuficientes"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"tipo": {
								"const": "pergunta"
							}
						}
					},
					"then": {
						"required": [
							"texto",
							"respostas"
						],
						"additionalProperties": false,
						"properties": {
							"tipo": true,
							"texto": {
								"type": "string",
								"minLength": 5,
								"maxLength": 200
							},
							"ajuda": {
								"type": "string",
								"maxLength": 400
							},
							"respostas": {
								"type": "array",
								"minItems": 2,
								"maxItems": 6,
								"items": {
									"type": "object",
									"required": [
										"texto",
										"ir_para"
									],
									"additionalProperties": false,
									"properties": {
										"texto": {
											"type": "string",
											"minLength": 1,
											"maxLength": 80
										},
										"ir_para": {
											"$ref": "common.schema.json#/$defs/id"
										}
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"tipo": {
								"const": "guia"
							}
						}
					},
					"then": {
						"required": [
							"guias"
						],
						"additionalProperties": false,
						"properties": {
							"tipo": true,
							"guias": {
								"type": "array",
								"minItems": 1,
								"items": {
									"$ref": "common.schema.json#/$defs/id"
								}
							},
							"nota": {
								"type": "string",
								"maxLength": 400
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"tipo": {
								"const": "tecnico"
							}
						}
					},
					"then": {
						"required": [
							"motivo"
						],
						"additionalProperties": false,
						"properties": {
							"tipo": true,
							"motivo": {
								"type": "string",
								"minLength": 10,
								"maxLength": 400
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"tipo": {
								"const": "dados_insuficientes"
							}
						}
					},
					"then": {
						"additionalProperties": false,
						"properties": {
							"tipo": true,
							"nota": {
								"type": "string",
								"maxLength": 400
							}
						}
					}
				}
			]
		}
	}
}
