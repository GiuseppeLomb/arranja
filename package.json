{
  "name": "arranja",
  "version": "0.1.0",
  "description": "Antes de deitar fora, arranja. Guias de reparação DIY de eletrodomésticos vendidos em Portugal.",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiuseppeLomb/arranja.git"
  },
  "homepage": "https://giuseppelomb.github.io/arranja/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx scripts/build-data.ts --exemplos && node node_modules/vite/bin/vite.js dev",
    "data": "node --import tsx scripts/build-data.ts",
    "data:dev": "node --import tsx scripts/build-data.ts --exemplos",
    "build": "node --import tsx scripts/build-data.ts && node node_modules/vite/bin/vite.js build",
    "build:demo": "node --import tsx scripts/build-data.ts --exemplos && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "validate": "node --import tsx scripts/validate.ts",
    "check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "import:eprel": "node --import tsx scripts/import-eprel.ts",
    "icons": "node node_modules/@vite-pwa/assets-generator/bin/pwa-assets-generator.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@lucide/svelte": "1.68.0",
    "canvas-confetti": "1.9.4",
    "fuse.js": "7.5.0",
    "motion": "14.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vite-pwa/sveltekit": "2.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "magicast": "0.5.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
